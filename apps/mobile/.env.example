# Supabase Auth e API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key

# URL da API Menu Digital (Issue #34)
# Emulador Android: http://10.0.2.2:3333
# Celular físico: use o IP local da máquina que executa a API
# Produção/staging: use a URL pública do servidor
EXPO_PUBLIC_API_URL=http://localhost:3333

# Ativação sob demanda de massa simulada de restaurantes para testes de clustering (Issue #35)
# true = usa 80 restaurantes fictícios locais | false (default) = consome API real
EXPO_PUBLIC_USE_MOCK_RESTAURANTS=false

