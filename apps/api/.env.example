# Servidor API
PORT=3333

# Pooler em transaction mode (uso normal da API)
DATABASE_URL="postgresql://postgres.PROJECT_REF:your-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler em session mode (migrações Prisma)
DIRECT_URL="postgresql://postgres.PROJECT_REF:your-password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase Auth e API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-admin-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Variáveis Compartilhadas / Fallback Monorepo
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key
