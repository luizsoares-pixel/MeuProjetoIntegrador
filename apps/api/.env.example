# Servidor API
PORT=3333

# Banco de Dados PostgreSQL (Conexão Direta para Prisma ORM)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Supabase Auth e API (Isolamento de Privilégios)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-admin-key

# Variáveis Compartilhadas / Fallback Monorepo
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key
